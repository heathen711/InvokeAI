# Copy this file to docker/.env and fill in your values:
#   cp docker/.env.example docker/.env

# Path to InvokeAI data directory (models, database, outputs).
# Needs ~15 GB free for the two SDXL benchmark models.
INVOKEAI_DATA_DIR=/path/to/invokeai-data

# Group IDs for GPU device access. Find yours with:
#   getent group video | cut -d: -f3   -> VIDEO_GID  (/dev/dri/card*)
#   getent group render | cut -d: -f3  -> RENDER_GID (/dev/kfd, /dev/dri/renderD*)
VIDEO_GID=44
RENDER_GID=993

# Tag used in SERVICE_NAME labels on stable configs. Optional.
IMAGE_LABEL=official

# --- Optional: hardware-specific overrides ---

# Set if your GPU is not natively recognised by the installed ROCm version.
# Examples: gfx1151 (Strix Halo) -> 11.0.0 | gfx1030 (V620) -> 10.3.0
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# Enable on discrete GPUs only. Do NOT set on APUs — causes performance regressions.
# TORCH_BLAS_PREFER_HIPBLASLT=1

# Override the AMD nightly index URL for the 'nightly' benchmark config.
# Default (set in docker-compose.yml) targets RDNA 2 discrete (gfx103X-dgpu).
# Override here for other architectures:
#   gfx1151 (Strix Halo):  https://rocm.nightlies.amd.com/v2-staging/gfx1151/
#   gfx110X (RDNA 3 dGPU): https://rocm.nightlies.amd.com/v2-staging/gfx110X-dgpu/
# NIGHTLY_INDEX=https://rocm.nightlies.amd.com/v2-staging/gfx103X-dgpu/
